# Path to your repos folder on the host machine.
# Use the form that matches the shell you run `docker compose` from:
#   Windows (PowerShell / Git Bash):  C:/Users/You/Documents/Git
#   WSL / Linux / Mac:                /mnt/c/Users/You/Documents/Git
# Cloud: leave empty — falls back to a named Docker volume.
#   Populate after startup: docker exec hermes git clone <url> /repos/<name>
REPOS_MOUNT=
