# Optional. Leave empty and Hermes sees the folder this repo sits in as
# /repos — which is already what you want if you cloned hermes-stack
# alongside your other repos.
#
# Only set this if your repos live somewhere else. A relative path (resolved
# against this folder) works from any shell; an absolute path must match the
# shell you run `docker compose` from — C:/Users/... from Windows,
# /mnt/c/Users/... from WSL.
REPOS_MOUNT=

# Dashboard login at http://localhost:9119 — also the credentials the Hermes
# desktop app uses to connect (Settings -> Gateways).
# Required: Hermes refuses to start the dashboard without a password.
DASHBOARD_USER=hermes
DASHBOARD_PASSWORD=

# Signs session cookies. Keep it stable so logins survive restarts.
# Generate with: openssl rand -base64 32
DASHBOARD_SECRET=
